# Copy to configs/paths.env, edit, then `source configs/paths.env` before running anything.

# MobileGym checkout (see README: pinned commit, built without its optional dataset).
export MOBILEGYM_DIR=$HOME/mobilegym

# Everything this code writes: runs/, data/, adapters/, merged reader models.
export WORK_DIR=$HOME/ptap_work

# Downloaded base models, one directory per model as named in configs/models.json.
export MODELS_DIR=$HOME/models

# Where the simulator is served (scripts/serve_sim.sh) and where the two model servers listen.
export SIM_URL=http://127.0.0.1:14173
export READER_URL=http://127.0.0.1:18200/v1/chat/completions
export POLICY_URL=http://127.0.0.1:18100/v1/chat/completions

# Optional: AndroidControl's data (androidcontrol/download.sh; default $WORK_DIR/androidcontrol).
# export ANDROIDCONTROL_DIR=$HOME/androidcontrol

# Optional: where Playwright keeps its browser (default: its own cache directory).
# export PLAYWRIGHT_BROWSERS_PATH=$HOME/pw-browsers

# Keep CPU use modest on shared machines.
export OMP_NUM_THREADS=1
